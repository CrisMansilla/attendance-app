<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title || 'Attendance App' %></title>

  <!-- Bootstrap -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />
</head>
<body>
  <!-- Responsive Navbar -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark p-3">
    <div class="container-fluid">
      <a class="navbar-brand" href="/">Ir al inicio</a>

      <!-- Hamburger / toggle button -->
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent"
        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>

      <!-- Collapsible content -->
      <div class="collapse navbar-collapse" id="navbarSupportedContent">
        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
          <li class="nav-item">
            <a class="nav-link text-white" href="/students">Estudiantes</a>
          </li>
          <li class="nav-item">
            <a class="nav-link text-white" href="/attendance">Tomar asistencia</a>
          </li>
          <li class="nav-item">
            <a class="nav-link text-white" href="/repertoire">Revisar repertorio</a>
          </li>
          <li class="nav-item">
            <a class="nav-link text-white" href="/check_log">Revisar contenidos</a>
          </li>
          <li class="nav-item">
            <a class="nav-link text-white" href="/add_log">Agregar contenido visto de la clase</a>
          </li>
          <li class="nav-item">
            <a class="nav-link text-white" href="/summary">Revisión mensual</a>
          </li>
          <li class="nav-item">
            <a class="nav-link text-white" href="/extra_class">Recuperación de clases</a>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <div class="container mt-4">
    <!-- Inject page-specific content -->
    <%- body %>
  </div>

  <!-- Optional: Bootstrap JS -->
  <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
  </script>
</body>
</html>
